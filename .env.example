# Assina o token de acesso e deriva o segredo de cada instalacao.
# Defina em producao: com o valor padrao, qualquer um que leia o codigo emite tokens.
GATEWAY_SIGNING_SECRET=troque-este-valor

# Codigos aceitos no provisionamento, separados por virgula.
CODIGOS_DE_INSTALACAO=AB73-KL92,DEMO-0001

# O contrato pede que o codigo valha uma unica vez. `true` relaxa isso para demonstracao.
PERMITIR_REPROVISIONAMENTO=true

NOME_DA_ACADEMIA=Academia Exemplo

# Redis (Upstash / Vercel KV). Sem estas duas, o armazenamento e em memoria.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
